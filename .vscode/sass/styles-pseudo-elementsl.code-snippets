{
	"After": {
		"prefix": "aft",
		"scope": "css, sass, less",
		"body": ["&:after", "\tcontent: ''", "\t$1"],
		"description": "After"
	},

	"After without content": {
		"prefix": "&aft",
		"scope": "css, sass, less",
		"body": ["&:after", "\t$1"],
		"description": "After without content"
	},

	"$:before, &:after": {
		"prefix": "befaft",
		"scope": "css, sass, less",
		"body": ["&:before, &:after", "\tcontent: ''", "\t$1"],
		"description": "$:before, &:after"
	},

	"Before": {
		"prefix": "bef",
		"scope": "css, sass, less",
		"body": ["&:before", "\tcontent: ''", "\t$1"],
		"description": "Before"
	},

	"Before without content": {
		"prefix": "&bef",
		"scope": "css, sass, less",
		"body": ["&:before", "\t$1"],
		"description": "Before without content"
	},
}
