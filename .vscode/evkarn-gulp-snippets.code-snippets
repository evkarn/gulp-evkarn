{
	"Video block iframe": {
		"prefix": "vidif",
		"scope": "css, sass, scss, less",
		"body": [
			"position: relative",
			"padding-bottom: 56.25%",
			"",
			"max-width: 100%",
			"width: 100%",
			"height: auto",
			"",
			"iframe",
			"\twidth: 100%",
			"\theight: 100%",
			"",
			"\tposition: absolute",
			"\ttop: 0",
			"\tright: 0",
			"\tbottom: 0",
			"\tleft: 0",
			"",
			"\tobject-fit: cover"
		],
		"description": "Video block iframe"
	},














	// Clip
	"clip-path: none": {
		"prefix": "cpn",
		"scope": "css, sass, scss, less",
		"body": ["clip-path: none"],
		"description": "clip-path: none"
	},

	"clip: auto": {
		"prefix": "cla",
		"scope": "css, sass, scss, less",
		"body": ["clip: auto"],
		"description": "clip: auto"
	},
	// End. Clip


	"image-responsive-position-absolute": {
		"prefix": "img-resp",
		"scope": "css, sass, scss, less",
		"body": [
			"position: absolute",
			"top: 0",
			"right: 0",
			"bottom: 0",
			"left: 0",
			"\t",
			"width: 100%",
			"height: 100%",
			"\t",
			"object-fit: cover"
		],
		"description": "image-responsive-position-absolute"
	},









	// Flex
	"Display flex center": {
		"prefix": "dfc",
		"scope": "css, sass, scss, less",
		"body": ["display: flex", "align-items: center", "justify-content: center"],
		"description": "Display flex center"
	},

	"Flex: 1 1 auto": {
		"prefix": "f11a",
		"scope": "css, sass, scss, less",
		"body": [
			"flex-shrink: 1",
			"flex-grow: 1",
			"flex-basis: auto"
		],
		"description": "Flex: 1 1 auto"
	},
	// End. Flex



	"Hide element": {
		"prefix": "hid",
		"scope": "css, sass, scss, less",
		"body": [
			"position: absolute",
			"top: -110%",
			"left: -110%",
			"pointer-events: none",
			"visibility: hidden",
			"font-size: 0",
			"line-height: 0",
			"width: 0",
			"height: 0"
		],
		"description": "Hide element"
	},

	"Position absolute centering top": {
		"prefix": "abct",
		"scope": "css, sass, scss, less",
		"body": ["position: absolute", "top: 50%", "transform: translateY(-50%)"],
		"description": "Position absolute centering top"
	},



	"color: var": {
		"prefix": "cv",
		"scope": "css, sass, scss, less",
		"body": ["color: var($1)"],
		"description": "color: var"
	},


	"Link rel nofollow": {
		"prefix": "relno",
		"scope": "html, php",
		"body": [
			"<a class=\"$1\" href=\"$2\" rel=\"nofollow\" target=\"_blank\">$3</a>"
		],
		"description": "Link rel nofollow"
	},


	// Pointer-events
	"Pointer-events: none": {
		"prefix": "pen",
		"scope": "css, sass, scss, less",
		"body": ["pointer-events: none"],
		"description": "Pointer-events: none"
	},

	"Pointer-events: auto": {
		"prefix": "pea",
		"scope": "css, sass, scss, less",
		"body": ["pointer-events: auto"],
		"description": "Pointer-events: auto"
	},
	// Pointer-events

	// Overlay
	"Overlay": {
		"prefix": "over",
		"scope": "css, sass, scss, less",
		"body": [
			"&:after",
			"\tcontent: ''",
			"\tdisplay: block",
			"\theight: 100%",
			"\twidth: 100%",
			"\tposition: absolute",
			"\ttop: 0",
			"\tright: 0",
			"\tbottom: 0",
			"\tleft: 0",
			"\topacity: $1",
			"\tbackground-color: $2"
		],
		"description": "Overlay"
	},
	// End. Overlay



	// Rub symbol
	"Rub symbol": {
		"prefix": "rub",
		"scope": "css, sass, scss, less",
		"body": ["&::after", "\tcontent: '₽'"],
		"description": "Rub symbol"
	},

	"Rub text": {
		"prefix": "rubt",
		"scope": "css, sass, scss, less",
		"body": ["&::after", "\tcontent: 'руб.'"],
		"description": "Rub text"
	},
	// End. Rub symbol


}
