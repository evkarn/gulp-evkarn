{
	"background-color: var()": {
		"prefix": "bg-color-var",
		"scope": "css, scss, sass, less",
		"body": [
			"background-color: var($1);"
		],
		"description": "background-color: var()"
	},

	"background-color: var(--c-accent)": {
		"prefix": "bg-color-var-accent",
		"scope": "css, scss, sass, less",
		"body": [
			"background-color: var(--c-accent);"
		],
		"description": "background-color: var(--c-accent)"
	},

	"background-color: transparent": {
		"prefix": "bg-color-transparent",
		"scope": "css, scss, sass, less",
		"body": [
			"background-color: transparent;"
		],
		"description": "background-color: transparent"
	},

	"background all": {
		"prefix": "bg-all",
		"scope": "css, scss, sass, less",
		"body": [
			"background-color: var($1);",
			"background-image: url('$2');",
			"background-position: center;",
			"background-repeat: no-repeat;",
			"background-size: cover;"
		],
		"description": "background all"
	}

	"background image-set": {
		"prefix": "bg-img-set",
		"scope": "css, scss, sass, less",
		"body": [
			"background-image: image-set(url("$1.webp") type("image/webp") 1x, url("$1@2x.webp") type("image/webp") 2x, url("$1.avif") type("image/avif") 1x, url("$1@2x.avif") type("image/avif") 2x, url("$1.jpg") type("image/jpg") 1x, url("$1@2x.jpg") type("image/jpg") 2x;",
		],
		"description": "background image-set"
	}
}