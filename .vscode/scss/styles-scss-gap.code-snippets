{
	"gap: rem()": {
		"prefix": "gp",
		"scope": "css, sass, scss, less",
		"body": ["gap: rem($1);"],
		"description": "gap: rem()"
	},

	"row-gap: rem()": {
		"prefix": "rgp",
		"scope": "css, sass, scss, less",
		"body": ["row-gap: rem($1);"],
		"description": "row-gap: rem()"
	},

	"column-gap: rem()": {
		"prefix": "cgp",
		"scope": "css, sass, scss, less",
		"body": ["column-gap: rem($1);"],
		"description": "column-gap: rem()"
	},

	"gap: px": {
		"prefix": "gppx",
		"scope": "css, sass, scss, less",
		"body": ["gap: $1px;"],
		"description": "gap: px"
	},

	"row-gap: px": {
		"prefix": "rgppx",
		"scope": "css, sass, scss, less",
		"body": ["row-gap: $1px;"],
		"description": "row-gap: px"
	},

	"column-gap: px": {
		"prefix": "cgppx",
		"scope": "css, sass, scss, less",
		"body": ["column-gap: $1px;"],
		"description": "column-gap: px"
	}
