	"Swiper HTML Layout": {
		"prefix": "swr",
		"scope": "html, php",
		"body": [
			"<div class=\"$1 swiper\">",
			"\t<div class=\"swiper-wrapper\">",
			"\t\t<div class=\"swiper-slide\">Slide 1</div>",
