	"Picture tag retina": {
		"prefix": "picr",
		"scope": "html, php",
		"body": [
			"<picture>",
			"\t<source srcset=\"@img/$1.webp\" type=\"image/webp\" />",
			"",
			"\t<img src=\"@img/$2.jpg\" alt=\"$3\"/>",
			"</picture>",
		],
		"description": "Picture tag retina"
	},

	"Lazy load picture retina": {
		"prefix": "llpicr",
		"scope": "html, php",
		"body": [
			"<picture>",
			"\t<source srcset=\"@img/$1.webp\" type=\"image/webp\" />",
