	},

	"Section bootstrap": {
		"prefix": "secbs",
		"scope": "html, php",
		"body": [
			"<div class=\"section $1\">",
			"\t<div class=\"container $2__container\">",
			"\t\t<div class=\"row\">",
			"\t\t\t<div class=\"col-$3\">",
			"\t\t\t\t$4",
			"\t\t\t</div>",
			"\t\t</div>",
			"\t</div>",
			"</div>"
		],
		"description": "Section bootstrap"
	},


	"Media hover": {
		"prefix": "hah",
		"scope": "css, sass, scss, less",
		"body": [
			"@media ( any-hover: hover )",
			"\t&:hover",
			"\t\t$1",
		],
		"description": "Media hover"
	},


