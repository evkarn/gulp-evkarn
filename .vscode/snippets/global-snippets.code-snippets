	"Article block": {
		"prefix": "artb",
		"scope": "html, php",
		"body": [
			"<article class=\"page__article article\" itemscope=\"itemscope\" itemtype=\"http://schema.org/NewsArticle\">",
			"\t<div class=\"article__author hidden\">",
			"\t\t<span>Автор:</span>",
			"",
			"\t\t<span itemprop=\"author\">Евгений Карнаухов</span>",
			"\t</div>",
			"",
			"\t<header class=\"article__header\" aria-hidden=\"true\">",
			"\t\t<a class=\"article__image-wrap\" href=\"$1\" itemprop=\"url\">",
			"\t\t\t<img class=\"article__image\" src=\"@img/$2-1x.$3\" srcset=\"@img/$2-2x.$3 2x\" alt=\"$4\" itemprop=\"image\">",
			"\t\t</a>",
			"\t</header>",
			"",
			"\t<div class=\"article__content\">",
			"\t\t<div class=\"article__meta\">",
			"\t\t\t<time datetime=\"$5 27-02-2022\" itemprop=\"datePublished\">",
			"\t\t\t\t$6 27 февраля 2022 года, 09:00",
			"\t\t\t</time>",
			"\t\t</div>",
			"",
			"\t\t<h3 class=\"article__title\" itemprop=\"headline\">",
			"\t\t\t<a href=\"$1\" itemprop=\"url\">",
			"\t\t\t\t<span itemprop=\"name\">",
			"\t\t\t\t\t$7",
			"\t\t\t\t</span>",
			"\t\t\t</a>",
			"\t\t</h3>",
			"",
			"\t\t<div class=\"article__description\">",
			"\t\t\t<div>",
			"\t\t\t\t<p>",
			"\t\t\t\t\t$8",
			"\t\t\t\t</p>",
			"\t\t\t</div>",
			"\t\t</div>",
			"\t</div>",
			"",
			"\t<footer class=\"article__footer\">",
			"\t\t<a class=\"article__button\" href=\"$1\">",
			"\t\t\t<span>Читать далее</span>",
			"\t\t</a>",
			"\t</footer>",
			"</article>"
		],
		"description": "Article block"
	},

