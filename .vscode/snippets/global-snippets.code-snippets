	},


	"Position absolute centering": {
		"prefix": "abc",
		"scope": "css, sass, scss, less",
		"body": [
			"position: absolute",
			"top: 50%",
			"left: 50%",
			"transform: translate(-50%, -50%)",
		],
		"description": "Position absolute centering"
	},


	"Hide element": {
		"prefix": "hid",
		"scope": "css, sass, scss, less",
		"body": [
			"position: absolute",
			"top: -110%",
			"left: -110%",
			"pointer-events: none",
			"visibility: hidden",
			"font-size: 0",
			"line-height: 0",
			"width: 0",
			"height: 0",
		],
		"description": "Hide element"
	},


	"Position absolute centering top": {
		"prefix": "abct",
		"scope": "css, sass, scss, less",
		"body": [
			"position: absolute",
			"top: 50%",
			"transform: translateY(-50%)",
		],
		"description": "Position absolute centering top"
	},


