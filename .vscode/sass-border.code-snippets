{
	"Border-radius var": {
		"prefix": "bradv",
		"body": [
			"border-radius: var(--border-radius)",
			"",
			"@media ( min-width: em(2880.96) )",
			"\tborder-radius: calc(var(--border-radius) * 2)"
		],
		"description": "Border-radius var"
	},

	"Border-radius": {
		"prefix": "brad",
		"body": [
			"border-radius: $1",
			"+calc-size(border-radius, $1, $2, 1920.96, 3840, px)",
			"",
			"@media ( min-width: em(3840.96) )",
			"\tborder-radius: $2"
		],
		"description": "Border-radius"
	},
}
