{
	"outline-color: transparent": {
		"prefix": "outl-color-transparent",
		"scope": "css, sass, scss, less",
		"body": ["outline-color: transparent;"],
		"description": "outline-color: transparent"
	},

	"outline-color: var($1)": {
		"prefix": "outl-color-var",
		"scope": "css, sass, scss, less",
		"body": ["outline-color: var($1);"],
		"description": "outline-color: var($1)"
	},

	"outline-color: rgba($1outline-color, $2)": {
		"prefix": "outl-color-rgba",
		"scope": "css, sass, scss, less",
		"body": ["outline-color: rgba($1 / $2);"],
		"description": "outline-color: rgba($1outline-color, $2)"
	},

	"outline all px": {
		"prefix": "outl-all-px",
		"scope": "css, sass, scss, less",
		"body": [
			"outline-width: \\$outline-width + px;",
			"outline-style: dashed;",
			"outline-color: currentColor;",
			"outline-offset: \\$outline-offset + px;",
			"",
			"@media ( min-width: 1920.96px ) {",
			"\t@include calc-size(outline-width, \\$outline-width, \\$outline-width * 2, 1920, 3840, px);",
			"\t@include calc-size(outline-offset, \\$outline-offset, \\$outline-offset * 2, 1920, 3840, px);",
			"}"
		],
		"description": "outline all px"
	},

	"outline all-rem": {
		"prefix": "outl-all-rem",
		"scope": "css, sass, scss, less",
		"body": [
			"outline-width: rem(\\$outline-width);",
			"outline-style: dashed;",
			"outline-color: currentColor;",
			"outline-offset: rem(\\$outline-offset);",
			"",
			"@media ( min-width: em(1920.96) ) {",
			"\t@include calc-size(outline-width, \\$outline-width, \\$outline-width * 2, 1920, 3840, rem);",
			"\t@include calc-size(outline-offset, \\$outline-offset, \\$outline-offset * 2, 1920, 3840, rem);",
			"}"
		],
		"description": "outline all-rem"
	}
}
