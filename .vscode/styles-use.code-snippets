{
	"use general, grid, units": {
		"prefix": "use-all",
		"scope": "css, scss, sass, scss, less",
		"body": [
			"@use '../$1variables/general' as *;",
			"@use '../$1variables/grid' as *;",
			"@use '../$1mixins/fluid-size' as *;",
		],
	},
	"@use": {
		"prefix": "@use",
		"scope": "css, scss, sass, scss, less",
		"body": [
			"@use '.$1';",
		],
	},
	"use units": {
		"prefix": "use-units",
		"scope": "css, scss, sass, scss, less",
		"body": [
			"@use '../$1mixins/units' as *;"
		],
	},
	"use ad-txt": {
		"prefix": "use-fluid-size",
		"scope": "css, scss, sass, scss, less",
		"body": [
			"@use '../$1mixins/fluid-size' as *;"
		],
	},
	"use grid": {
		"prefix": "use-grid",
		"scope": "css, scss, sass, scss, less",
		"body": [
			"@use '../$1variables/grid' as *;"
		],
	},
	"use general": {
		"prefix": "use-general",
		"scope": "css, scss, sass, scss, less",
		"body": [
			"@use '../$1variables/general' as *;"
		],
	},
}