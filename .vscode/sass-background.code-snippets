{
	"background-color: var()": {
		"prefix": "bgc-var",
		"scope": "sass",
		"body": ["background-color: var($1)"],
		"description": "background-color: var()"
	},

	"background-color: var(--c-accent)": {
		"prefix": "bgc-var-accent",
		"scope": "sass",
		"body": ["background-color: var(--c-accent)"],
		"description": "background-color: var(--c-accent)"
	},

	"background-color: transparent": {
		"prefix": "bgc-transparent",
		"scope": "sass",
		"body": ["background-color: transparent"],
		"description": "background-color: transparent"
	},

	"background inline": {
		"prefix": "bg-inline",
		"scope": "sass",
		"body": ["style=\"background-color: $1; background-image: url('$2'); background-position: center; background-repeat: no-repeat; background-size: cover\""],
		"description": "background inline"
	},

	"background all": {
		"prefix": "bg-all",
		"scope": "sass",
		"body": [
			"background-attachment: scroll",
			"background-clip: border-box",
			"background-color: $1",
			"background-image: url('$2')",
			"background-position: center",
			"background-repeat: no-repeat",
			"background-size: cover",
		],
		"description": "background all"
	},
}
