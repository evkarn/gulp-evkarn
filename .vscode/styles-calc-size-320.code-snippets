{
	"Calc size without property px": {
		"prefix": "cs-no-mixin-px-sm",
		"scope": "css, scss, sass, less",
		"body": [
			"calc($1px + ($2 - $1) * ((100vw - 320px) / (1920 - 320)))"
		],
		"description": "Calc size without property px"
	},

	"Calc size without property rem": {
		"prefix": "cs-no-mixin-rem-sm",
		"scope": "css, scss, sass, less",
		"body": ["calc(rem($1) + ($2 - $1) * ((100vw - rem(320)) / (1920 - 320)))"],
		"description": "Calc size without property rem"
	},

	"Calc size": {
		"prefix": "cs-sm",
		"scope": "css, scss, sass, less",
		"body": ["@include calc-size($1, $2, $3, 320, 1920, rem);"],
		"description": "Calc size"
	},

	"Calc size px": {
		"prefix": "cs-Px-sm",
		"scope": "css, scss, sass, less",
		"body": ["@include calc-size($1, $2, $3, 320, 1920, px)"],
		"description": "Calc size px"
	},

