	"Article block jekyll": {
		"prefix": "articleJekyll",
		"scope": "html, php, njk, md",
		"body": [
			"<article class=\"section-main__article article\" itemscope=\"itemscope\" itemtype=\"https://schema.org/Article\">",
			"\t<div class=\"article__author hidden\" itemprop=\"author\" itemscope=\"\" itemtype=\"https://schema.org/Person\">",
			"",
			"\t\t<link itemprop=\"sameAs\" href=\"{{ site.url }}\" />",
			"",
			"\t\t<a href=\"{{ site.authorAboutLink }}\">",
			"\t\t\t<span itemprop=\"name\">{{ site.author }}</span>",
			"\t\t</a>",
			"\t</div>",
			"",
			"\t<header class=\"article__header\" aria-hidden=\"true\">",
			"\t\t<a class=\"article__image-wrap\" href=\"{{ post.url }}\" itemprop=\"url\">",
			"\t\t\t<img class=\"article__image\" src=\"assets/imagess/dist/blog/{{ post.imageThumbHome }}\" alt=\"{{ post.introBgImageAlt }}\" itemprop=\"image\" loading=\"lazy\">",
			"\t\t</a>",
			"\t</header>",
			"",
			"\t<div class=\"article__main\">",
			"\t\t<div class=\"article__meta meta\">",
			"\t\t\t<div class=\"meta-date date\">",
			"\t\t\t\t<span class=\"article__icon icon-clock\"></span>",
			"",
			"\t\t\t\t<time datetime=\"{{ post.date | date: '%Y' }}-{{ post.date | date: '%m' }}-{{ post.date | date: '%d' }}\" itemprop=\"datePublished\">",
			"\t\t\t\t\t{{ post.date | date: '%d' }}.{{ post.date | date: '%m' }}.{{ post.date | date: '%Y' }} года",
			"\t\t\t\t</time>",
			"\t\t\t</div>",
			"",
			"\t\t\t<div class=\"meta-category category\">",
			"\t\t\t\t<span class=\"category__icon icon-category\"></span>",
			"",
			"\t\t\t\t<a class=\"category__link\" href=\"blog/{{ post.category }}/\"",
			"\t\t\t\t\t{{ post.categoryName }}",
			"\t\t\t\t</a>",
			"\t\t\t</div>",
			"\t\t</div>",
			"",
			"\t\t<h3 class=\"article__title\" itemprop=\"headline\">",
			"\t\t\t<a href=\"{{ post.url }}\" itemprop=\"url\">",
			"\t\t\t\t<span itemprop=\"name\">",
			"\t\t\t\t\t{{ post.title }}",
			"\t\t\t\t</span>",
			"\t\t\t</a>",
			"\t\t</h3>",
			"",
			"\t\t<div class=\"article__description\">",
			"\t\t\t<div>",
			"\t\t\t\t<p>",
			"\t\t\t\t\t{{ post.description }}",
			"\t\t\t\t</p>",
			"\t\t\t</div>",
			"\t\t</div>",
			"\t</div>",
			"",
			"\t<footer class=\"article__footer\">",
			"\t\t<a class=\"article__button\" href=\"{{ post.url }}\">",
			"\t\t\t<span>{{ site.readMoreButtonText }}</span>",
			"\t\t</a>",
			"\t</footer>",
			"</article>"
		],
		"description": "Article block jekyll"
	},

