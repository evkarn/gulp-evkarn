{
	"Fonts preload": {
		"prefix": "fpr",
		"scope": "html, php, njk, md",
		"body": [
			"<link rel=\"preload\" href=\"$1\" as=\"font\" type=\"font/woff2\" crossorigin>"
		],
		"description": "Fonts preload"
	},

	"Section": {
		"prefix": "sec",
		"scope": "html, php, njk, md",
		"body": [
			"<section class=\"section $1\">",
			"\t<div class=\"container $1__container\">",
			"\t\t$2",
			"\t</div>",
			"</section>"
		],
		"description": "Section"
	},

	"Swiper HTML Layout": {
		"prefix": "swiper",
		"scope": "html, php, njk, md",
		"body": [
			"<div class=\"$1 swiper\">",
			"\t<div class=\"swiper-wrapper\">",
			"\t\t<div class=\"swiper-slide\">Slide 1</div>",
			"\t</div>",
			"",
			"\t<div class=\"swiper-pagination\"></div>",
			"",
			"\t<button class=\"swiper-button-prev\"></button>",
			"\t<button class=\"swiper-button-next\"></button>",
			"",
			"\t<div class=\"swiper-scrollbar\"></div>",
			"</div>"
		],
		"description": "Swiper HTML Layout"
	},

	"Section bootstrap": {
		"prefix": "secbs",
		"scope": "html, php, njk, md",
		"body": [
			"<div class=\"section $1\">",
			"\t<div class=\"container $1__container\">",
			"\t\t<div class=\"row $1__row\">",
			"\t\t\t<div class=\"col-$2\">",
			"\t\t\t\t$3",
			"\t\t\t</div>",
			"\t\t</div>",
			"\t</div>",
			"</div>"
		],
		"description": "Section bootstrap"
	},
}