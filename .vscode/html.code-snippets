	"Inner image responsive": {
		"prefix": "inimgr",
		"scope": "html, php",
		"body": [
			"position: relative",
			"overflow: hidden",
			"padding-bottom: calc($1 / $2)",
			"",
			"\timg",
			"\t\tposition: absolute",
			"\t\twidth: 100%",
			"\t\theight: 100%",
			"\t\ttop: 0",
			"\t\tright: 0",
			"\t\tbottom: 0",
			"\t\tleft: 0",
			"\t\tobject-fit: cover"
		],
		"description": "Inner image responsive"
	},

