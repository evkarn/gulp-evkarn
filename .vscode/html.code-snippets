	// Article
	"Article block": {
		"prefix": "artb",
		"scope": "html, php",
		"body": [
			"<article class=\"section-main__article article\" itemscope=\"itemscope\" itemtype=\"http://schema.org/Article\">",
			"\t<div class=\"article__author hidden\" itemprop=\"author\" itemscope=\"\" itemtype=\"http://schema.org/Person\">",
			"",
			"\t\t<link itemprop=\"sameAs\" href=\"//intellektfinance.ru/\" />",
			"",
			"\t\t<a href=\"//intellektfinance.ru/o-proekte.html\">",
			"\t\t\t<span itemprop=\"name\">Евгений Карнаухов</span>",
			"\t\t</a>",
			"\t</div>",
			"",
			"\t<header class=\"article__header\" aria-hidden=\"true\">",
			"\t\t<a class=\"article__image-wrap\" href=\"$1\" itemprop=\"url\">",
			"\t\t\t<img class=\"article__image\" src=\"@img/$2-1x.$3\" srcset=\"@img/$2-2x.$3 2x\" alt=\"$4\" itemprop=\"image\" loading=\"lazy\">",
			"\t\t</a>",
			"\t</header>",
			"",
			"\t<div class=\"article__main\">",
			"\t\t<div class=\"article__meta meta\">",
			"\t\t\t<div class=\"meta-date date\">",
			"\t\t\t\t<span class=\"date__icon icon-clock\"></span>",
			"",
			"\t\t\t\t<time datetime=\"$5 27-02-2022\" itemprop=\"datePublished\">",
			"\t\t\t\t\t$6 27 февраля 2022 года, 09:00",
			"\t\t\t\t</time>",
			"\t\t\t</div>",
			"",
			"\t\t\t<div class=\"meta-category category\">",
			"\t\t\t\t<span class=\"category__icon icon-category\"></span>",
			"",
			"\t\t\t\t<a class=\"category__link\" href=\"\"",
			"\t\t\t\t\t$6",
			"\t\t\t\t</a>",
			"\t\t\t</div>",
			"\t\t</div>",
			"",
			"\t\t<h3 class=\"article__title\" itemprop=\"headline\">",
			"\t\t\t<a href=\"$1\" itemprop=\"url\">",
			"\t\t\t\t<span itemprop=\"name\">",
			"\t\t\t\t\t$7",
			"\t\t\t\t</span>",
			"\t\t\t</a>",
			"\t\t</h3>",
			"",
			"\t\t<div class=\"article__description\">",
			"\t\t\t<div>",
			"\t\t\t\t<p>",
			"\t\t\t\t\t$8",
			"\t\t\t\t</p>",
			"\t\t\t</div>",
			"\t\t</div>",
			"\t</div>",
			"",
			"\t<footer class=\"article__footer\">",
			"\t\t<a class=\"article__button\" href=\"$1\">",
			"\t\t\t<span>Читать далее</span>",
			"\t\t</a>",
			"\t</footer>",
			"</article>"
		],
		"description": "Article block"
	},

	"Article block jekyll": {
		"prefix": "artbj",
		"scope": "html, php",
		"body": [
			"<article class=\"section-main__article article\" itemscope=\"itemscope\" itemtype=\"http://schema.org/Article\">",
			"\t<div class=\"article__author hidden\" itemprop=\"author\" itemscope=\"\" itemtype=\"http://schema.org/Person\">",
			"",
			"\t\t<link itemprop=\"sameAs\" href=\"{{ site.url }}\" />",
			"",
			"\t\t<a href=\"{{ site.authorAboutLink }}\">",
			"\t\t\t<span itemprop=\"name\">{{ site.author }}</span>",
			"\t\t</a>",
