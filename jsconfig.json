{
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"],
			"@components/*": ["src/components/*"],
			"@js/*": ["src/js/*"],
			"@funcs/*": ["src/js/functions/*"],
			"@utils/*": ["src/js/utils/*"],
			"@modules/*": ["src/js/modules/*"],
			"@constants/*": ["src/js/constants/*"],
			"@styles/*": ["src/styles/scss/*"]
		}
	},
	"include": ["src"]
}
