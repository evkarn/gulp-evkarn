{
	"name": "gulp-evkarn",
	"version": "3.2.0",
	"description": "Gulp-сборка для вёрстки сайтов: SCSS + webpack, спрайты, картинки WebP/AVIF, деплой на FTP/SSH",
	"main": "gulpfile.js",
	"type": "module",
	"scripts": {
		"dev": "gulp",
		"build": "gulp build --build",
		"zip": "gulp deployZip --build",
		"ftp": "gulp deployFTP --build",
		"ssh": "gulp deploySSH --build",
		"fonts": "gulp fonts",
		"files": "gulp files",
		"lint:js": "eslint .",
		"lint:js:fix": "eslint . --fix",
		"lint:css": "stylelint \"**/*.{css,scss,pcss}\"",
		"lint:css:fix": "stylelint \"**/*.{css,scss,pcss}\" --fix",
		"format": "prettier . --check",
		"format:fix": "prettier . --write",
		"lint": "npm run lint:js && npm run lint:css && npm run format",
		"lint:fix": "npm run lint:js:fix && npm run lint:css:fix && npm run format:fix"
	},
	"author": "evkarn.ru",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/evkarn/gulp-evkarn.git"
	},
